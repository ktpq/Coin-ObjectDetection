# ชื่อ model ที่ใข้ ค่า default เป็น model ที่เราเทรนไว้ให้ เหรียญ 1,5,10 baht
MODEL_NAME=example-my-model

# ชื่อ model ที่คุณสร้างขึ้น/ ลบ (เพื่อไม่ให้กระทบ model ที่เทรนไว้ให้)
CREATED_MODEL_NAME=my-model

# ชื่อ โฟลเดอร์ของรูปภาพที่เราจะใช้ train โดยจะเอาโฟลเดอร์ไว้ในลำดับชั้นเดียวกับ run.py 

IMAGES_PATH=images

# มี format ดังนี้

# [folder_name]
#     - [number]_[subfolder_name]
#         - image
#         - image
#         ...
#     - [number]_[subfolder_name]
#         - image
#         - image
#         ...
#     - [number]_[subfolder_name]
#         - image
#         - image
#         ...

# Ex.
# images
#     - 1_1baht
#         - image
#         - image
#         ...
#     - 2_5baht
#         - image
#         - image
#         ...
#     - 3_10baht
#         - image
#         - image
#         ...

